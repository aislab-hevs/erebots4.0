# Copy to ".env" in the directory you start the application from — that working
# directory is where the file is read from. EREBOTS_ENV_FILE points elsewhere;
# EREBOTS_IGNORE_DOTENV=1 skips the file entirely. A variable already set in the
# environment always wins over the value here.
#
# ---------------------------------------------------------------------------
# Minimal local run (no Docker, no Keycloak, no Postgres) — the README
# "Quickstart" one-liner. You only need these overrides; everything below this
# block configures the full Docker deployment:
#
#   enable_auth=false
#   database_url=sqlite+aiosqlite:///./dev.db
#   orchestrator_api_base_url=<any OpenAI-compatible endpoint>/v1
#   conversion_api_base_url=<same or another endpoint>/v1
#   personal_api_base_url=<same or another endpoint>/v1
#   orchestrator_model=... conversion_model=... personal_model=...
#   (plus *_api_key=... when the endpoint requires one)
# ---------------------------------------------------------------------------

# Keycloak Configuration (for full Docker deployment)
keycloak_url=https://auth.erebots.local
keycloak_public_url=https://auth.erebots.local
keycloak_internal_url=http://erebots-keycloak:8080
keycloak_realm=erebots
keycloak_client_id=erebots-webapp
keycloak_client_secret=
app_callback_url=https://app.erebots.local/api/auth/callback

# Authentication
enable_auth=true
jwt_cookie_name=access_token
id_token_cookie_name=id_token
jwt_cookie_secure=true

# Off, and nothing here needs it. It existed for Gradio-hosted tool servers,
# which serve an MCP call by calling themselves back over loopback with no
# Authorization header; every tool server this application ships is built with
# the MCP SDK now and speaks POST with its own bearer.
#
# Leave it false unless you mount something like Gradio under /tools/, and never
# on a deployment where /tools/* is reachable from outside -- enabling it trusts
# the peer address.
allow_loopback_tool_reads=false

# Internal service-account client (M2M auth for /a2a/* and /tools/*)
# IMPORTANT: set a unique secret and configure the same value on the
# 'erebots-internal' client in Keycloak. The app refuses to start with this
# placeholder when enable_auth=true.
internal_client_id=erebots-internal
internal_client_secret=change-me-internal-client-secret

# Application Configuration (Docker)
app_host=0.0.0.0
app_port=7860
# Maximum tool-calling rounds a specialist may run in one turn.
tool_loop_max_iterations=3

# Application database (separate Postgres instance from Keycloak's DB)
database_url=postgresql+asyncpg://erebots:erebots@erebots-app-db:5432/erebots

# Orchestrator Agent
orchestrator_api_key=EMPTY
orchestrator_api_base_url=http://host.docker.internal:8080/v1
orchestrator_model=local
orchestrator_thinking=false

# Conversion Agent (answers come from a deterministic tool, so a small
# model is enough)
conversion_api_key=EMPTY
conversion_api_base_url=http://host.docker.internal:8080/v1
conversion_model=local
conversion_thinking=false

# Personal Agent. The only agent that reads or writes a user's profile and
# consents; every other agent asks it through its MCP tools.
personal_api_key=EMPTY
personal_api_base_url=http://host.docker.internal:8080/v1
personal_model=local
personal_thinking=false

# CORS Configuration
cors_origins=["https://app.erebots.local", "https://auth.erebots.local"]
# UI branding: logo/title text and the path the chat UI is mounted at
# ("/" serves the chat at the root; use e.g. /chat for a sub-path)
brand_name=EREBOTS
ui_path=/
# Which chat UI to serve there: gradio (in-process) or web (static Vue SPA,
# same-origin cookie auth). Both consume the same orchestrator core.
frontend=gradio

# Most recent chat-history messages forwarded to the LLM per turn
# (user+assistant pair = 2; 0 = no cap)
chat_history_max_messages=20

# Hard limits on one POST /api/chat/stream request: body bytes (413 when
# exceeded), text chars per message, images per message and bytes per image
# data URL (422 when exceeded).
chat_request_max_bytes=8388608
chat_message_max_chars=20000
chat_images_max_per_message=4
chat_image_max_bytes=5242880

# Routing prompt: true = list every agent skill (rich, better with large
# routers); false = name+description only (lean, better with small routers).
# The A2A card always advertises every skill regardless.
routing_include_skills=true

# The A2A endpoints the orchestrator routes to. A relative path resolves
# against the working directory, so a wheel install can point this anywhere.
agents_config_path=agents.yaml

# Seconds before an agent or MCP server that failed discovery is retried
# (the ones found stay usable meanwhile).
discovery_retry_seconds=30

# How many specialists one turn may fan out to. 1 = single-agent dispatch
# (one target per turn); higher lets a cross-domain request reach several
# specialists, which run in parallel and are composed into one reply.
orchestrator_max_specialists=3
# How those answers become one reply: synthesis (an extra LLM call merges
# them into a single text) or sections (concatenated under a per-agent
# heading — no extra call, nothing can distort what a specialist said).
multi_agent_composition=synthesis

# Set to false when any configured model is text-only: image parts are then
# stripped before every request and replaced by a placeholder, so the model
# answers instead of failing on content it cannot parse.
multimodal_enabled=true

# Opt-in retry flattening the prompt on vLLM/Qwen chat-template parser errors (off by default)
enable_parser_retry=false
# Persist A2A tasks in the app DB (needed only for multiple API instances; off by default)
a2a_persistent_tasks=false
# Mount the A2A conformance endpoint at /a2a/tck for the a2a-tck suite. It answers
# from canned fixtures, not from an agent — enable it only to run the suite.
a2a_conformance_agent=false
# Seconds before a task parked in input-required (ask_user) is canceled if the
# user never answers. 0 disables expiry.
a2a_parked_task_ttl=900
# Accept push-notification webhooks on plain HTTP or non-public addresses. The
# agent POSTs the task's own content to that URL, so the default policy (https +
# globally routable) is what stops a caller aiming this server at your network.
# Enable it only to run the a2a-tck suite, whose receiver is on http://localhost.
a2a_push_allow_insecure_webhooks=false
